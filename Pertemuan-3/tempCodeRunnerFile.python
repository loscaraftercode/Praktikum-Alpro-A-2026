#Buku
class kelasBuku:
    def __init__(self, judul, penulis, tahun):
        self.judul = judul
        self.penulis = penulis
        self.tahun = tahun
        self.tersedia =  True

    def infoBuku(self):
        print("Judul Buku :", self.judul)
        print("Penulis Buku :", self.penulis)
        print("Tahun Terbit Buku :", self.tahun)
        print("Status Buku :","Tersedia" if self.tersedia else "dipinjam")

    def pinjamBuku(self):
        if self.tersedia:
            self.terrsedia = False
            print("Buku berhasil dipinjam.")
        else:
            print("Buku sedang dipinjam.")

    def kembalikan(self):
        self.tersedia = True
        print("buku sudah dikembalian")

p1 = kelasBuku("The Overworldly Minthyu", "Carlos", 2027)
p1.infoBuku()
p1.pinjamBuku()
p1.infoBuku()